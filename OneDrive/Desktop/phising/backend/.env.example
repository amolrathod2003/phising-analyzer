# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/phishguard
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/phishguard
MONGODB_URI=mongodb://localhost:27017/phishguard

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
PORT=5000

# API Keys (optional - app works in demo mode without these)
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
